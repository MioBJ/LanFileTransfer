# 服务配置
APP_NAME=局域网文件传输服务
VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
WORKERS=2

# 存储路径
STORAGE_PATH=/storage
TEMP_PATH=/storage/temp
UPLOADS_PATH=/storage/uploads

# 上传配置
CHUNK_SIZE=10485760                  # 10MB
CHUNK_THRESHOLD=104857600            # 100MB
MAX_CONCURRENT_UPLOADS=10

# 清理配置（手动清理脚本使用）
TEMP_FILE_EXPIRY=86400              # 24小时（默认过期时间）

# 日志配置
LOG_LEVEL=INFO
LOG_PATH=/logs
